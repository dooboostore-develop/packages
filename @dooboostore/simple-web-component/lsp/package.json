{
  "name": "swc-lsp",
  "version": "0.0.0",
  "description": "SWC language server — shipped inside @dooboostore/simple-web-component as `swc-lsp`. Editor plugins: plugins/vscode, plugins/intellij",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "node build.mjs && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^20",
    "esbuild": "^0.23.0",
    "typescript": "6.0.3",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11"
  }
}
