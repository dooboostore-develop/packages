{
  "name": "@dooboostore/simple-web-component-lsp",
  "displayName": "Simple Web Component",
  "version": "0.1.0",
  "description": "SWC language server (shipped inside @dooboostore/simple-web-component as `swc-lsp`) + VS Code client",
  "private": true,
  "license": "MIT",
  "publisher": "dooboostore",
  "main": "./out/client/extension.js",
  "engines": {
    "node": ">=18",
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:html"
  ],
  "contributes": {
    "grammars": [
      {
        "scopeName": "swc.injection",
        "path": "./syntaxes/swc.injection.json",
        "injectTo": [
          "source.ts",
          "source.tsx",
          "source.js",
          "source.js.jsx",
          "text.html.basic",
          "text.html.derivative"
        ],
        "embeddedLanguages": {
          "meta.embedded.swc": "javascript"
        }
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "node build.mjs && node --test test/*.test.mjs"
  },
  "dependencies": {
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.23.0",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11"
  }
}
